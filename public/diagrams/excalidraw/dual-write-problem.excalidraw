{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "type": "rectangle",
      "version": 1,
      "id": "order-srv",
      "x": 60,
      "y": 60,
      "width": 180,
      "height": 100,
      "strokeColor": "#0d9488",
      "backgroundColor": "#f0fdfa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "roundness": { "type": 3 }
    },
    {
      "type": "text",
      "version": 1,
      "id": "order-srv-txt",
      "x": 85,
      "y": 95,
      "text": "Order Service\n(Business Logic)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "strokeColor": "#115e59"
    },
    {
      "type": "arrow",
      "version": 1,
      "id": "arr-db",
      "x": 240,
      "y": 90,
      "width": 140,
      "height": 0,
      "points": [[0, 0], [140, 0]],
      "strokeColor": "#0ca678",
      "strokeWidth": 2,
      "roughness": 1
    },
    {
      "type": "text",
      "version": 1,
      "id": "txt-db-ok",
      "x": 255,
      "y": 68,
      "text": "1. SQL Commit ✓",
      "fontSize": 12,
      "fontFamily": 3,
      "strokeColor": "#0ca678"
    },
    {
      "type": "rectangle",
      "version": 1,
      "id": "db-box",
      "x": 380,
      "y": 60,
      "width": 160,
      "height": 80,
      "strokeColor": "#0ca678",
      "backgroundColor": "#e6fcf5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "type": "text",
      "version": 1,
      "id": "db-txt",
      "x": 405,
      "y": 88,
      "text": "Database State\n(Order Created)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#0ca678"
    },
    {
      "type": "arrow",
      "version": 1,
      "id": "arr-kafka",
      "x": 240,
      "y": 130,
      "width": 140,
      "height": 70,
      "points": [[0, 0], [70, 70], [140, 70]],
      "strokeColor": "#e03131",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1
    },
    {
      "type": "text",
      "version": 1,
      "id": "txt-kafka-fail",
      "x": 250,
