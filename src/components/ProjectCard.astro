---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>['data'];
}

const { project } = Astro.props;

const accentClasses: Record<Props['project']['accent'], string> = {
  teal: 'bg-teal-100 dark:bg-teal-950/80 text-teal-800 dark:text-teal-300 dark:border-teal-800/60',
  purple: 'bg-purple-100 dark:bg-purple-950/80 text-purple-800 dark:text-purple-300 dark:border-purple-800/60',
  amber: 'bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 dark:border-amber-800/60',
  green: 'bg-green-100 dark:bg-green-950/80 text-green-800 dark:text-green-300 dark:border-green-800/60',
  indigo: 'bg-indigo-100 dark:bg-indigo-950/80 text-indigo-800 dark:text-indigo-300 dark:border-indigo-800/60',
  red: 'bg-red-100 dark:bg-red-950/80 text-red-800 dark:text-red-300 dark:border-red-800/60',
};
---

<div class="bg-white dark:bg-slate-900 rounded-xl shadow-xs hover:shadow-md transition-all duration-300 border border-slate-200 dark:border-slate-800 flex flex-col overflow-hidden group">
  <div class="p-6 flex-1 flex flex-col">
    <div class="flex items-center justify-between mb-4">
      <span
        class={`px-3 py-1 border border-transparent rounded-full text-xs font-semibold uppercase tracking-wide ${accentClasses[project.accent]}`}
      >
        {project.category}
      </span>
      <a
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${project.title} repository on GitHub`}
        class="text-slate-400 dark:text-slate-500 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
      </a>
    </div>

    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors font-display">
      {project.title}
    </h3>

    <p class="text-slate-600 dark:text-slate-400 text-sm mb-3 leading-relaxed flex-1">
      {project.description}
    </p>

    {project.impact && (
      <p class="text-xs font-semibold text-teal-700 dark:text-teal-300 mb-4">
        Impact: {project.impact}
      </p>
    )}

    <div class="flex flex-wrap gap-1.5 mb-5 font-mono">
      {project.stack.map((item) => (
        <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">
          {item}
        </span>
      ))}
    </div>

    <a
      href={project.repo}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center text-sm font-semibold text-teal-600 dark:text-teal-400 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
    >
      View Repository →
    </a>
  </div>
</div>
