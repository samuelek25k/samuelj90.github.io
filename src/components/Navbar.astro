---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isBlog = currentPath.startsWith('/blog');
---

<header class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md sticky top-0 z-40 border-b border-slate-200 dark:border-slate-800 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Avatar -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-full p-0.5 bg-gradient-to-tr from-teal-500 to-cyan-400">
        <img
          src="/assets/images/profile.png"
          alt="Samuel J Mathew"
          class="w-full h-full rounded-full object-cover bg-white dark:bg-slate-900"
        />
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-slate-900 dark:text-white group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors font-display text-sm sm:text-base leading-tight">
          Samuel J Mathew
        </span>
        <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium hidden sm:inline">
          Architect • Advocate
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 sm:gap-2 text-sm font-medium">
      <a
        href="/#projects"
        class="px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        Projects
      </a>
      <a
        href="/#skills"
        class="px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        Skills
      </a>
      <a
        href="/#timeline"
        class="px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        Journey
      </a>
      <!-- Blog Nav Link with Active State -->
      <a
        href="/blog"
        class={`px-3 py-1.5 rounded-lg transition-colors font-semibold ${
          isBlog
            ? 'text-teal-700 dark:text-teal-300 bg-teal-50 dark:bg-teal-950/80 border border-teal-200 dark:border-teal-800/60'
            : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800'
        }`}
      >
        Blog
      </a>

      <div class="h-4 w-px bg-slate-200 dark:bg-slate-800 mx-2"></div>

      <a
        href="/#contact"
        class="px-3.5 py-1.5 rounded-lg bg-teal-600 hover:bg-teal-700 text-white font-medium transition-all shadow-xs text-xs sm:text-sm"
      >
        Connect
      </a>

      <!-- Theme Switcher -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="ml-1 p-2 rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-colors"
      >
        <svg id="theme-sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg id="theme-moon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      </button>
    </nav>

    <!-- Mobile Menu Trigger -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="theme-toggle-mobile"
        type="button"
        aria-label="Toggle theme"
        class="p-2 rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700"
      >
        <svg id="theme-sun-mobile" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg id="theme-moon-mobile" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      </button>

      <button
        id="mobile-btn"
        type="button"
        aria-label="Toggle menu"
        class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div id="mobile-drawer" class="hidden md:hidden border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 py-4 space-y-2">
    <a href="/#projects" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Projects</a>
    <a href="/#skills" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Skills</a>
    <a href="/#timeline" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">Journey</a>
    <a
      href="/blog"
      class={`block px-3 py-2 rounded-lg text-base font-medium ${
        isBlog
          ? 'text-teal-700 dark:text-teal-300 bg-teal-50 dark:bg-teal-950/80'
          : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800'
      }`}
    >
      Blog
    </a>
    <a href="/#contact" class="block px-3 py-2 rounded-lg text-base font-semibold text-teal-600 dark:text-teal-400">Connect →</a>
  </div>
</header>

<script is:inline>
  (function() {
    function initTheme() {
      const sun = document.getElementById('theme-sun');
      const moon = document.getElementById('theme-moon');
      const sunM = document.getElementById('theme-sun-mobile');
      const moonM = document.getElementById('theme-moon-mobile');
      const isDark = document.documentElement.classList.contains('dark');

      [sun, sunM].forEach(el => el && (isDark ? el.classList.remove('hidden') : el.classList.add('hidden')));
      [moon, moonM].forEach(el => el && (isDark ? el.classList.add('hidden') : el.classList.remove('hidden')));
    }

    function toggle() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      initTheme();
    }

    document.getElementById('theme-toggle')?.addEventListener('click', toggle);
    document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggle);

    const mobileBtn = document.getElementById('mobile-btn');
    const drawer = document.getElementById('mobile-drawer');
    if (mobileBtn && drawer) {
      mobileBtn.addEventListener('click', () => drawer.classList.toggle('hidden'));
    }

    initTheme();
  })();
</script>
