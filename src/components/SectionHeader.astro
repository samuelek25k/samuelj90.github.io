---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  class: className = '',
} = Astro.props;
---

<div class={`mb-10 sm:mb-12 ${align === 'center' ? 'text-center max-w-3xl mx-auto' : 'max-w-3xl'} ${className}`}>
  <span class="text-xs font-semibold tracking-wider uppercase text-teal-600 dark:text-teal-400 font-mono">
    {eyebrow}
  </span>
  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 text-slate-900 dark:text-white font-display tracking-tight text-balance">
    {title}
  </h2>
  <p class="text-slate-600 dark:text-slate-400 mt-3 text-base sm:text-lg leading-relaxed">
    {description}
  </p>
</div>
