---
interface Props {
  title: string;
  subtitle: string;
  date: string;
  description: string;
  impact?: string;
  tags?: string[];
  isCurrent?: boolean;
}

const {
  title,
  subtitle,
  date,
  description,
  impact,
  tags = [],
  isCurrent = false,
} = Astro.props;
---

<div class="relative group">
  <!-- Marker Dot -->
  <div
    class={`absolute -left-[31px] sm:-left-[39px] top-2 w-4 h-4 rounded-full ring-4 ring-slate-50 dark:ring-slate-950 transition-all ${
      isCurrent
        ? 'bg-teal-600 ring-teal-200 dark:ring-teal-900/60 shadow-md scale-110'
        : 'bg-slate-300 dark:bg-slate-700'
    }`}
  ></div>

  <!-- Card Frame -->
  <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 sm:p-7 shadow-sm hover:shadow-md transition-all min-w-0">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 sm:gap-4 mb-3">
      <div class="min-w-0 flex-1">
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors font-display truncate">
          {title} &bull; <span class="font-semibold text-slate-700 dark:text-slate-300">{subtitle}</span>
        </h3>
      </div>
      <!-- Uniform neutral date badge meeting 4.5:1 contrast -->
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 shrink-0 w-fit order-first sm:order-last">
        {date}
      </span>
    </div>

    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-3 break-words">
      {description}
    </p>

    {impact && (
      <p class="text-xs font-semibold text-teal-700 dark:text-teal-300 mb-3 flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
        Impact: {impact}
      </p>
    )}

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 text-xs font-medium">
        {tags.map((tag) => (
          <span class="px-2.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/60 font-mono">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</div>
