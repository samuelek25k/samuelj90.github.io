---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  excalidrawUrl?: string;
}

const { src, alt, caption, excalidrawUrl } = Astro.props;
---

<figure class="my-8 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-xs excalidraw-container">
  <div class="px-4 py-2.5 border-b border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
    <div class="flex items-center gap-2 font-mono font-medium">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-violet-500"></span>
      <span>Excalidraw Sketch</span>
    </div>
    {excalidrawUrl && (
      <a
        href={excalidrawUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-violet-600 dark:text-violet-400 hover:underline flex items-center gap-1 font-mono"
      >
        <span>Open Raw Scene</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    )}
  </div>
  <div class="p-4 sm:p-6 overflow-x-auto flex justify-center">
    <img
      src={src}
      alt={alt}
      class="w-full h-auto max-w-4xl rounded-lg excalidraw-img"
      loading="lazy"
    />
  </div>
  {caption && (
    <figcaption class="px-4 pb-4 text-xs text-center text-slate-500 dark:text-slate-400 font-mono">
      {caption}
    </figcaption>
  )}
</figure>
