---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
  target?: string;
  rel?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  target,
  rel,
  class: className = '',
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 shadow-xs focus:ring-2 focus:ring-teal-500 focus:outline-hidden shrink-0 w-fit";

const variants = {
  primary: "bg-teal-600 hover:bg-teal-700 text-white hover:shadow",
  secondary: "bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 hover:border-slate-400 dark:hover:border-slate-600 text-slate-700 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white"
};

const combinedClasses = `${baseStyles} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} target={target} rel={rel} class={combinedClasses}>
    <slot />
  </a>
) : (
  <button type={type} class={combinedClasses}>
    <slot />
  </button>
)}
