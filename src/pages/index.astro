---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).slice(0, 3);
---

<BaseLayout
  title="Samuel J Mathew | Senior Software Engineer • Technical Architect • Developer Advocate"
  description="Enterprise architecture, distributed systems, resilient backends, and AI agent engineering."
>
  <Navbar />

  <main>
<!-- Hero Section -->
    <section
      class="flex flex-col items-center justify-center text-center py-16 sm:py-20 lg:py-24 px-4 animate-fade-in max-w-5xl mx-auto"
    >
      <!-- Profile Avatar -->
      <div class="relative mb-6 group">
        <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-full p-1 bg-gradient-to-tr from-teal-500 via-teal-600 to-cyan-500 ring-4 ring-teal-100 shadow-xl group-hover:scale-105 transition-all duration-300">
          <img
            src="assets/images/profile.png"
            alt="Samuel J Mathew"
            class="w-full h-full rounded-full object-cover bg-white"
          />
        </div>
        <div class="absolute bottom-1 right-1 w-6 h-6 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center text-[10px] text-white font-bold" title="Open to Architecture Collaboration">
          ✓
        </div>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-teal-50 dark:bg-teal-950/80 border border-teal-200 dark:border-teal-800/60 text-teal-800 dark:text-teal-300 text-xs sm:text-sm font-semibold mb-6 tracking-wide">
        <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
        Engineering Portfolio &amp; Architecture Showcase
      </div>

      <h1
        class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight mb-4"
      >
        Samuel J Mathew
      </h1>

      <p class="text-lg sm:text-2xl md:text-3xl font-semibold bg-gradient-to-r from-teal-600 via-teal-500 to-cyan-500 dark:from-teal-400 dark:via-teal-300 dark:to-cyan-400 bg-clip-text text-transparent mb-6">
        Senior Software Engineer &bull; Technical Architect &bull; Developer Advocate
      </p>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed mb-8">
        Specializing in high-scale distributed backends, AI-native automation, and resilient cross-platform systems. Focused on clean architecture, deterministic verification, and developer tooling.
      </p>

      <div class="flex flex-wrap gap-4 justify-center items-center">
        <a
          href="#projects"
          class="px-6 py-3 rounded-lg bg-teal-600 hover:bg-teal-700 text-white font-medium shadow-sm transition-all duration-200 hover:shadow flex items-center gap-2 text-sm sm:text-base"
        >
          View Flagship Systems
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>
        <a
          href="#contact"
          class="px-6 py-3 rounded-lg bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 hover:border-slate-400 dark:hover:border-slate-600 text-slate-700 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white font-medium transition-all duration-200 text-sm sm:text-base"
        >
          Get In Touch
        </a>
      </div>
    </section>

    <!-- Core Engineering Focus & Architectural Domains -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid lg:grid-cols-2 gap-8">
        <!-- Card 1: Core Competencies -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm hover:shadow-md transition-all">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-teal-600">Production Capabilities</span>
              <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-display">Areas of Expertise</h2>
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-3 text-sm">
            <div class="flex items-center gap-2 p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              <span class="w-2 h-2 rounded-full bg-teal-500"></span> Distributed Microservices
            </div>
            <div class="flex items-center gap-2 p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              <span class="w-2 h-2 rounded-full bg-teal-500"></span> Real-time Event Streaming
            </div>
            <div class="flex items-center gap-2 p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              <span class="w-2 h-2 rounded-full bg-teal-500"></span> Cloud-Native Infrastructure
            </div>
            <div class="flex items-center gap-2 p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              <span class="w-2 h-2 rounded-full bg-teal-500"></span> AI &amp; MCP Agent Engineering
            </div>
            <div class="flex items-center gap-2 p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              <span class="w-2 h-2 rounded-full bg-teal-500"></span> High-Frequency Payments
            </div>
            <div class="flex items-center gap-2 p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              <span class="w-2 h-2 rounded-full bg-teal-500"></span> Enterprise Frontend Systems
            </div>
          </div>
        </div>

        <!-- Card 2: Strategic Technical Focus -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm hover:shadow-md transition-all">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 flex items-center justify-center font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600">Architectural Horizon</span>
              <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-display">Specialized Domains</h2>
            </div>
          </div>
          <div class="space-y-3 text-sm">
            <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              <span class="font-semibold text-slate-900 dark:text-white">JVM &amp; Enterprise Runtime</span>: Spring Boot 3, Java 21, low-latency concurrent processing.
            </div>
            <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              <span class="font-semibold text-slate-900 dark:text-white">Modern TypeScript &amp; React</span>: Strict typing, micro-frontends, state synchronization.
            </div>
            <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              <span class="font-semibold text-slate-900 dark:text-white">Kubernetes &amp; Cloud DevOps</span>: Container orchestration, automated GitOps, CI verification.
            </div>
            <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300">
              <span class="font-semibold text-slate-900 dark:text-white">Zero-Trust &amp; Cryptography</span>: Secure token lifecycle, authenticated encryption, policy gates.
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-slate-200 dark:border-slate-800"></div>

    <!-- Skills Section -->

    
    <!-- Featured Architecture & Flagship Projects Section -->
    <section id="projects" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="text-center mb-12">
        <span class="text-teal-600 font-semibold tracking-wider uppercase text-sm">Engineering Portfolio</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 text-slate-900 dark:text-white">Featured Architecture &amp; Systems</h2>
        <p class="text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mt-3 text-base sm:text-lg">
          Selected open-source production architectures, AI-native platforms, and developer systems engineered with clean design, automated quality gates, and high reliability.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Project Card 1: QRIMS -->
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 border border-slate-200 dark:border-slate-800 flex flex-col overflow-hidden group">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <span class="px-3 py-1 bg-teal-100 dark:bg-teal-950/80 text-teal-800 dark:text-teal-300 border border-transparent dark:border-teal-800/60 rounded-full text-xs font-semibold uppercase tracking-wide">Full-Stack System</span>
              <a href="https://github.com/samuelj90/qrims" target="_blank" class="text-slate-400 dark:text-slate-500 group-hover:text-teal-700 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </a>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-teal-700 transition-colors">QRIMS</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm mb-4 leading-relaxed flex-1">
              QR-based multi-tenant inventory &amp; asset management system featuring automated mobile scanner apps, real-time sync, and comprehensive CI/CD pipelines.
            </p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">Flutter</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">NestJS</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">Next.js 14</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">Docker CI</span>
            </div>
            <a href="https://github.com/samuelj90/qrims" target="_blank" class="inline-flex items-center text-sm font-semibold text-teal-600 hover:text-teal-800 transition-colors">
              View Repository &rarr;
            </a>
          </div>
        </div>

        <!-- Project Card 2: ClerkAI -->
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 border border-slate-200 dark:border-slate-800 flex flex-col overflow-hidden group">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <span class="px-3 py-1 bg-purple-100 dark:bg-purple-950/80 text-purple-800 dark:text-purple-300 border border-transparent dark:border-purple-800/60 rounded-full text-xs font-semibold uppercase tracking-wide">AI &amp; Automation</span>
              <a href="https://github.com/samuelj90/clerkAi" target="_blank" class="text-slate-400 dark:text-slate-500 group-hover:text-purple-600 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </a>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-purple-600 transition-colors">ClerkAI</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm mb-4 leading-relaxed flex-1">
              AI-native back-office workflow assistant implementing the Model Context Protocol (MCP) for extensible tool orchestration, automated document OCR, and dynamic reports.
            </p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">Python</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">MCP Protocol</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">CrewAI</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">LLM Agents</span>
            </div>
            <a href="https://github.com/samuelj90/clerkAi" target="_blank" class="inline-flex items-center text-sm font-semibold text-purple-600 hover:text-purple-800 transition-colors">
              View Repository &rarr;
            </a>
          </div>
        </div>

        <!-- Project Card 3: VSafe -->
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 border border-slate-200 dark:border-slate-800 flex flex-col overflow-hidden group">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <span class="px-3 py-1 bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border border-transparent dark:border-amber-800/60 rounded-full text-xs font-semibold uppercase tracking-wide">Security &amp; DevTools</span>
              <a href="https://github.com/samuelj90/vsafe" target="_blank" class="text-slate-400 dark:text-slate-500 group-hover:text-amber-600 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </a>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-amber-600 transition-colors">VSafe Extension</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm mb-4 leading-relaxed flex-1">
              Developer security extension for VS Code that intercepts unauthorized external network requests and child process executions with real-time observability telemetry.
            </p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">TypeScript</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">VS Code API</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">Security Hooks</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">Telemetry</span>
            </div>
            <a href="https://github.com/samuelj90/vsafe" target="_blank" class="inline-flex items-center text-sm font-semibold text-amber-600 hover:text-amber-800 transition-colors">
              View Repository &rarr;
            </a>
          </div>
        </div>

        <!-- Project Card 4: Super Shots -->
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 border border-slate-200 dark:border-slate-800 flex flex-col overflow-hidden group">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <span class="px-3 py-1 bg-green-100 dark:bg-green-950/80 text-green-800 dark:text-green-300 border border-transparent dark:border-green-800/60 rounded-full text-xs font-semibold uppercase tracking-wide">Automation &amp; CI</span>
              <a href="https://github.com/samuelj90/super-shots" target="_blank" class="text-slate-400 dark:text-slate-500 group-hover:text-green-600 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </a>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-green-600 transition-colors">Super Shots</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm mb-4 leading-relaxed flex-1">
              High-performance Node.js web crawler and automated visual regression utility that crawls entire domains to capture full-page viewport screenshots on load completion.
            </p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">TypeScript</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">Node.js</span>
              <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/60 rounded text-xs">Puppeteer</span>
